# Required for the contact form. Add it in Vercel Project Settings > Environment Variables.
VITE_WEB3FORMS_KEY=

# Public production URL used for canonical tags and sitemap generation.
# Example: https://your-project.vercel.app
VITE_SITE_URL=

# Comma-separated extra hosts, for example: my-portfolio.vercel.app
VITE_ALLOWED_ORIGINS=

# Optional analytics. Leave both empty to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
